# A 线实验配置模板：复制为 .env 后填入你自己的凭证。
# .env 已被 git 忽略；API Key 不得进入对话、日志或版本库（AGENTS.md 红线）。

# ── GLM（智谱）：图像理解走这里（OpenAI 兼容接口）──
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
# 视觉模型按你账号可用的填（如 glm-4v-flash / glm-4v-plus 等）
GLM_MODEL_ID=

# ── DeepSeek：纯文本任务用（无视觉能力）──
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-chat

# ── MiniMax：上身预览图像生成（自有协议 /v1/image_generation）──
# 国内站 Key 填 https://api.minimaxi.com ；国际站 Key 填 https://api.minimax.io
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
# 选型决定（2026-10-27）：image-01，不做 live 对照
MINIMAX_MODEL_ID=image-01
MINIMAX_CAPABILITIES=image_generation

# ── 通用 ──
# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=60000
